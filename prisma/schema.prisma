generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum EventStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum CityGroupStatus {
  ENABLED
  PENDING_CREATE
  ACTIVE
  FULL
  FAILED
}

enum GroupJobStatus {
  PENDING
  PROCESSING
  DONE
  INVITED
  FAILED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ParticipantType {
  ESTUDANTE
  PROFESSOR
  PESQUISADOR
  PRODUTOR
}

enum NotificationType {
  COURSE_ENROLLED
  LESSON_COMPLETED
  NEW_COMMENT
  COURSE_UPDATED
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

model User {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  email                  String           @unique
  password               String? // Opcional para usuários do Google
  name                   String
  fullName               String? // Nome completo (obrigatório para Google)
  phone                  String? // Telefone/WhatsApp (obrigatório para Google)
  cpf                    String? // CPF
  birthDate              DateTime? // Data de nascimento
  participantType        ParticipantType? // Tipo de participante
  schoolOrUniversity     String? // Escola ou universidade (apenas para professores)
  hectares               Float? // Hectares (apenas para produtores)
  waterArea              Float? // Hectares de lâmina d'água (apenas para produtores)
  ponds                  Int? // Quantidade de viveiros (apenas para produtores)
  state                  String? // Estado
  city                   String? // Cidade
  role                   UserRole         @default(USER)
  avatar                 String?
  bio                    String?
  needsProfileCompletion Boolean          @default(false) // Se precisa completar cadastro
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  registrations        Registration[]
  enrollments          Enrollment[]
  courses              Course[]            @relation("CourseCreator")
  comments             Comment[]
  notifications        Notification[]
  progress             LessonProgress[]
  chat_channel_members ChatChannelMember[]
  chat_conversations   ChatConversation[]
  ai_assistant_config  AiAssistantConfig?

  @@map("users")
}

model AiAssistantConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  isActive  Boolean  @default(false)
  prompt    String?  
  context   String?  
  model     String?
  apiKey    String?
  apiKeyLabel String?
  allowEventCreation Boolean @default(true)
  allowCourseCreation Boolean @default(true)
  defaultMaxRegistrations Int @default(1000)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_assistant_configs")
}

model Event {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String
  bannerUrl        String?
  linkId           String      @unique
  slug             String?     @unique // URL personalizada
  status           EventStatus @default(ACTIVE)
  maxRegistrations Int?
  whatsappGroupsEnabled Boolean @default(false)
  whatsappSessionId String?    @db.ObjectId
  formCities       Json?       // lista de cidades exibidas no dropdown do formulário: [{ city, state }]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdBy        String      @db.ObjectId

  registrations  Registration[]
  municipalities MunicipalityLimit[]
  cityGroups     EventCityGroup[]

  @@map("events")
}

model MunicipalityLimit {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId           String   @db.ObjectId
  municipality      String
  state             String
  defaultLimit      Int      @default(20)
  registrationCount Int      @default(0)
  isClosed          Boolean  @default(false)
  closedMessage     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  classes       MunicipalityClass[]

  @@unique([eventId, municipality, state])
  @@map("municipality_limits")
}

enum MunicipalityClassStatus {
  ACTIVE
  CLOSED
}

model MunicipalityClass {
  id                  String                  @id @default(auto()) @map("_id") @db.ObjectId
  municipalityLimitId String                  @db.ObjectId
  classNumber         Int
  limit               Int
  currentCount        Int                     @default(0)
  status              MunicipalityClassStatus @default(ACTIVE)
  createdAt           DateTime                @default(now())
  closedAt            DateTime?
  updatedAt           DateTime                @updatedAt

  municipalityLimit MunicipalityLimit @relation(fields: [municipalityLimitId], references: [id], onDelete: Cascade)
  registrations     Registration[]

  @@unique([municipalityLimitId, classNumber])
  @@map("municipality_classes")
}

model Registration {
  id                  String  @id @default(auto()) @map("_id") @db.ObjectId
  eventId             String  @db.ObjectId
  userId              String? @db.ObjectId
  municipalityId      String? @db.ObjectId
  municipalityClassId String? @db.ObjectId
  batchNumber         Int     @default(1)

  // Dados do formulário
  name            String
  cpf             String
  phone           String
  email           String
  cep             String
  locality        String
  city            String
  state           String
  participantType ParticipantType
  otherType       String?
  pondCount       Int?
  waterArea       Float?

  status    RegistrationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id])
  municipality      MunicipalityLimit? @relation(fields: [municipalityId], references: [id])
  municipalityClass MunicipalityClass? @relation(fields: [municipalityClassId], references: [id])

  @@unique([eventId, cpf])
  @@map("registrations")
}

enum CourseType {
  PRESENCIAL
  ONLINE
}

model Course {
  id                       String     @id @default(auto()) @map("_id") @db.ObjectId
  title                    String
  description              String?
  bannerUrl                String?
  status                   String     @default("ACTIVE")
  type                     CourseType @default(ONLINE)
  maxEnrollments           Int?
  waitlistLimit            Int        @default(0)
  waitlistEnabled          Boolean    @default(false)
  regionRestrictionEnabled Boolean    @default(false)
  allowAllRegions          Boolean    @default(true)
  defaultRegionLimit       Int?
  startDate                DateTime?
  endDate                  DateTime?
  slug                     String?    @unique // URL personalizada
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  createdBy                String     @db.ObjectId

  creator      User                @relation("CourseCreator", fields: [createdBy], references: [id])
  lessons      Lesson[]
  enrollments  Enrollment[]
  regionQuotas CourseRegionQuota[]
  classes      CourseClass[]

  @@map("courses")
}

model Lesson {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String   @db.ObjectId
  title       String
  description String?
  videoUrl    String? // URL do YouTube
  bannerUrl   String? // Banner/Thumbnail da aula
  duration    String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  comments Comment[]
  progress LessonProgress[]

  @@map("lessons")
}

model Enrollment {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  userId            String           @db.ObjectId
  courseId          String           @db.ObjectId
  courseClassId     String?          @db.ObjectId // Turma do curso
  progress          Int              @default(0) // Porcentagem de conclusão
  completedAt       DateTime?
  status            EnrollmentStatus @default(CONFIRMED)
  waitlistPosition  Int?
  regionQuotaId     String?          @db.ObjectId
  eligibilityReason String?
  whatsappNumber    String?

  // Dados adicionais do registro
  cpf                String?
  birthDate          DateTime?
  participantType    ParticipantType?
  schoolOrUniversity String? // Escola ou universidade (apenas para professores)
  hectares           Float? // Apenas para produtores
  waterArea          Float? // Hectares de lâmina d'água (apenas para produtores)
  ponds              Int? // Quantidade de viveiros (apenas para produtores)
  state              String?
  city               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseClass CourseClass?       @relation(fields: [courseClassId], references: [id])
  regionQuota CourseRegionQuota? @relation(fields: [regionQuotaId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model CourseRegionQuota {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId      String   @db.ObjectId
  state         String
  city          String?
  limit         Int
  waitlistLimit Int      @default(0)
  currentCount  Int      @default(0)
  waitlistCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([courseId, state, city])
  @@map("course_region_quotas")
}

enum CourseClassStatus {
  ACTIVE
  CLOSED
}

model CourseClass {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  courseId     String            @db.ObjectId
  classNumber  Int // Número da turma (1, 2, 3...)
  limit        Int // Limite de vagas da turma
  currentCount Int               @default(0) // Quantidade atual de inscritos
  status       CourseClassStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  closedAt     DateTime?
  updatedAt    DateTime          @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([courseId, classNumber])
  @@map("course_classes")
}

enum EnrollmentStatus {
  CONFIRMED
  WAITLIST
  PENDING_REGION
  REJECTED
}

model LessonProgress {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  lessonId    String    @db.ObjectId
  completed   Boolean   @default(false)
  watchedTime Int       @default(0) // Tempo assistido em segundos
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  lessonId  String   @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Notification {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  userId    String             @db.ObjectId
  type      NotificationType
  title     String
  message   String
  link      String?
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model InstanceServer {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  url              String
  api_key          String
  status           String @default("active")
  max_instances    Int    @default(100)
  active_instances Int    @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  chat_channels ChatChannel[]

  @@map("instances_server")
}

model ChatChannel {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  company_id           String
  provider             String
  instance_server_id   String?   @db.ObjectId
  instance_name        String
  name                 String
  status               String
  phone_number         String?
  settings             Json?
  last_sync            DateTime?
  is_notification_only Boolean   @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  instances_server     InstanceServer?     @relation(fields: [instance_server_id], references: [id])
  chat_conversations   ChatConversation[]
  chat_channel_members ChatChannelMember[]

  @@map("chat_channels")
}

model ChatChannelMember {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  channel_id String @db.ObjectId
  user_id    String @db.ObjectId

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  channels ChatChannel @relation(fields: [channel_id], references: [id])
  users    User        @relation(fields: [user_id], references: [id])

  @@map("chat_channel_members")
}

model ChatConversation {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  channel_id      String    @db.ObjectId
  client_id       String? // References an arbitrary client table if it exists
  user_id         String?   @db.ObjectId
  provider_uid    String
  contact_name    String?
  contact_number  String?
  profile_pic_url String?
  last_message    String?
  last_message_at DateTime?
  unread_count    Int       @default(0)
  status          String    @default("OPEN")
  is_archived     Boolean   @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  channel  ChatChannel   @relation(fields: [channel_id], references: [id])
  users    User?         @relation(fields: [user_id], references: [id])
  messages ChatMessage[]

  @@map("chat_conversations")
}

model ChatMessage {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  conversation_id String    @db.ObjectId
  channel_id      String    @db.ObjectId
  provider_msg_id String
  direction       String
  content_type    String    @default("text")
  content         String?
  media_url       String?
  media_type      String?
  file_size       Int?
  mimetype        String?
  sender_name     String?
  status          String    @default("SENT")
  sent_at         DateTime  @default(now())
  read_at         DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversation_id], references: [id])

  @@map("chat_messages")
}

model ChatQuickResponse {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  company_id String
  title      String
  content    String
  shortcut   String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("chat_quick_responses")
}

model WhatsappAuthState {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  session_id String  @unique @db.ObjectId
  creds      Json?
  keys       Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("whatsapp_auth_states")
}

model EventCityGroup {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String          @db.ObjectId
  city      String
  state     String
  sessionId String          @db.ObjectId
  status    CityGroupStatus @default(ENABLED)
  groupJid  String?
  inviteCode String?
  lastError String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, city, state])
  @@map("event_city_groups")
}

model WhatsappGroupJob {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  registrationId String        @db.ObjectId
  cityGroupId    String        @db.ObjectId
  phone          String
  name           String
  status         GroupJobStatus @default(PENDING)
  attempts       Int           @default(0)
  maxAttempts    Int           @default(5)
  nextRunAt      DateTime      @default(now())
  allowCreate    Boolean?      // true = pode criar o grupo (inscrição nova); ausente/false = só adiciona a grupo existente (backfill)
  lastError      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([registrationId, cityGroupId])
  @@index([status, nextRunAt])
  @@map("whatsapp_group_jobs")
}
